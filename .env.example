# Server Configuration
PORT=3000
NODE_ENV=development

# Provider API Keys (Server-only; never expose in client code or commit real keys)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional administrator account email (first registered user also receives admin role if none exists)
ADMIN_EMAIL=mr216873@gmail.com

# Optional external backend URL when hosting the static frontend on GitHub Pages
VITE_API_BASE_URL=

# Optional comma-separated CORS allowlist (e.g. https://username.github.io)
CORS_ORIGIN=
